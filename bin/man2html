#!/usr/bin/env python3
"""Convert a mandoc man page into a page of collapsible sections.

usage: man2html [-T TEMPLATE] [-t TITLE] [-o OUT] MANFILE

  -T  page template; @TITLE@ and @MAN@ are replaced and @include(file)@ pulls in a file next to
      it (default: a minimal built-in page)
  -t  title (default: the file name as name(section), e.g. nnn.1 -> nnn(1))
  -o  output file (default: MANFILE with .html appended, e.g. nnn.1.html)

Each top-level section (.Sh) becomes <details class="man-sec"> and each
subsection (.Ss) a nested <details class="man-sub">; NAME and SYNOPSIS start
open. The markup inside comes from `mandoc -Thtml -O fragment` with the permalink
anchors removed and bare URLs linked. A literal block laid out as ` A | B | C` with a
`___ + ___ + ___` rule under the header becomes a table (a `Key` first column gets <kbd> keys). Style it from the template's stylesheet.
Sections get slug ids (#keybinds), environment variable paragraphs their name (#NNN_PILL) and
flag paragraphs opt-<flag> (#opt-G), so pages can link to them.
"""
import argparse
import html
import re
import subprocess
import sys
from pathlib import Path

OPEN = {"NAME", "SYNOPSIS"}  # sections that start expanded

DEFAULT = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@TITLE@</title>
</head>
<body>
<h1>@TITLE@</h1>
<div class="man">
@MAN@</div>
</body>
</html>
"""

URL = re.compile(r"https?://[^\s<>\"']*[^\s<>\"'.,;)]")


def title(h):
    return html.unescape(re.sub(r"<[^>]+>", "", h)).strip().title()


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def details(cls, name, body, opened=False, subs=""):
    ind = "      " if cls == "man-sec" else "        "
    return (
        f'{ind}<details class="{cls}" id="{slug(name)}"{" open" if opened else ""}>\n'
        f'{ind}  <summary>{html.escape(name, quote=False)}</summary>\n'
        f'{ind}  <div class="man-body">{body.strip()}</div>\n{subs}\n'
        f"{ind}</details>\n"
    )


def autolink(frag):
    """Link bare URLs in text that is not already inside an anchor."""
    out, depth = [], 0
    for tok in re.split(r"(<[^>]+>)", frag):
        if tok.startswith("<a ") or tok == "<a>":
            depth += 1
        elif tok == "</a>":
            depth -= 1
        elif not tok.startswith("<") and depth == 0:
            tok = URL.sub(r'<a href="\g<0>" target="_blank" rel="noopener">\g<0></a>', tok)
        out.append(tok)
    return "".join(out)


TABLE = re.compile(
    r'<div class="Bd[^"]*? Li">\s*<pre>\n?([^\n]*\|[^\n]*)\n(_+(?: \+ _+)+)\n(.*?)</pre>\s*</div>', re.DOTALL)
TOKEN = re.compile(r"<[^>]+>|&#?\w+;|.")


KEYIDS = set()  # ids given to the keys of Key tables; the first table to list a key owns it


def keyid(t):
    return "key-" + "".join(c if c.isalnum() else "_%02x" % ord(c) for c in t)


def kbd(t, anchor=False):
    if t == ";;":
        return "<kbd>;</kbd><kbd>;</kbd>"
    attr = ""
    if anchor and keyid(t) not in KEYIDS:
        KEYIDS.add(keyid(t))
        attr = f' id="{keyid(t)}"'
    return f"<kbd{attr}>{html.escape(t, quote=False)}</kbd>"


LITERAL = re.compile(r'(<div class="Bd[^"]*? Li">\s*<pre>)(.*?)(</pre>)', re.DOTALL)


def dedent(m):
    """Drop the source's leading blank lines and the indent every line of a literal block shares."""
    lines = m.group(2).strip("\n").split("\n")
    pad = min((len(l) - len(l.lstrip(" ")) for l in lines if l.strip()), default=0)
    return m.group(1) + "\n".join(l[pad:] for l in lines) + m.group(3)


def split_cells(line, seps):
    """Cut a line at the columns of the rule's `+`, counting an entity as one column, a tag as none."""
    cells, col = [""], 0
    for tok in TOKEN.findall(line):
        if tok.startswith("<"):
            cells[-1] += tok
            continue
        if col in seps:
            cells.append("")
        else:
            cells[-1] += tok
        col += 1
    return [c.strip() for c in cells]


def table(m):
    """A literal block with a ` A | B` header and a `___ + ___` rule under it becomes a table.

    Columns are cut where the rule has its `+`, so a cell may contain `|`. A row with an empty first
    cell, or with every other cell empty, continues the row above. With the first header `Key`, that
    column is drawn as <kbd> keys.
    """
    seps = {i for i, ch in enumerate(m.group(2)) if ch == "+"}
    head = split_cells(m.group(1), seps)
    n = len(head)
    rows = []
    for line in m.group(3).split("\n"):
        if not line.strip() or line.startswith("__"):
            continue
        cells = split_cells(line, seps)
        cells += [""] * (n - len(cells))
        if rows and (not cells[0] or not any(cells[1:])):
            for i, c in enumerate(cells):
                if c:
                    rows[-1][i] = (rows[-1][i] + " " + c).strip()
        else:
            rows.append(cells)
    keys = head[0] == "Key"
    body = ""
    for row in rows:
        if keys:
            plain = html.unescape(re.sub(r"<[^>]+>", "", row[0]))
            row[0] = ", ".join(kbd(k, True) for k in re.split(r", +", plain))
        body += "<tr>" + "".join(f"<td>{c}</td>" for c in row) + "</tr>\n"
    th = "".join(f"<th>{h}</th>" for h in head)
    return (f'<div class="table-wrap"><table>\n<thead><tr>{th}</tr></thead>\n'
            f"<tbody>\n{body}</tbody>\n</table></div>")


REF = re.compile(r'<b>(-[A-Za-z0-9]|[A-Z][A-Z0-9_]+)</b>|<code class="Fl">(-[A-Za-z0-9])</code>')


def link_refs(frag):
    """Link a bold or .Fl flag (-y) and a bold ENV_VAR to the paragraph that defines it."""
    ids = set(re.findall(r'<p class="Pp" id="((?:opt-[A-Za-z0-9]+)|[A-Z][A-Z0-9_]*)"', frag))

    def sub(m):
        name = m.group(1) or m.group(2)
        target = "opt-" + name[1:] if name.startswith("-") else name
        before = frag[:m.start()]
        if target not in ids or before.endswith(f'id="{target}">') or before.rfind("<a ") > before.rfind("</a>"):
            return m.group(0)
        return f'<a href="#{target}">{m.group(0)}</a>'

    return REF.sub(sub, frag)


def convert(frag):
    KEYIDS.clear()
    frag = frag[frag.index('<section class="Sh">'):].split('<table class="foot">')[0]
    # no self-links: drop mandoc's permalink anchors and the ids they point at
    frag = re.sub(r'<a class="permalink"[^>]*>(.*?)</a>', r"\1", frag, flags=re.DOTALL)
    frag = re.sub(r'(<(?!h[12]\b)[a-z]+(?: [^>]*?)?) id="[^"]*"', r"\1", frag)
    # anchors for deep links: an ENVIRONMENT_VARIABLE: paragraph gets its name, a -flag paragraph opt-flag
    frag = re.sub(r'<p class="Pp">(<b>([A-Z][A-Z0-9_]*):</b>)', r'<p class="Pp" id="\2">\1', frag)
    frag = re.sub(r'<p class="Pp">(<code class="Fl">-([A-Za-z0-9]+)</code>)', r'<p class="Pp" id="opt-\2">\1', frag)
    # a single bold-italic letter (\\f(BIx) marks an underlined mnemonic key
    frag = re.sub(r"<b><i>(.)</i></b>", r"<b><u>\1</u></b>", frag)
    # a line that starts with spaces breaks the line, which at the top of a paragraph is a blank first line
    frag = re.sub(r'(<p class="Pp"[^>]*>)\s*<br/>\s*', r'\1', frag)
    # a key in brackets (.Bq Ic X) is drawn as a key
    frag = re.sub(r'\[<code class="Ic">(.*?)</code>\]', r'<kbd>\1</kbd>', frag)
    frag = TABLE.sub(table, frag)
    frag = LITERAL.sub(dedent, frag)
    # an inline key (.Ic y) outside a tag list is drawn as a key, linked to its row in a Key table
    frag = re.sub(r'(?<!<dt>)<code class="Ic">(.*?)</code>',
                  lambda m: f'<a href="#{keyid(html.unescape(m.group(1)))}">{kbd(m.group(1))}</a>'
                  if keyid(html.unescape(m.group(1))) in KEYIDS else kbd(html.unescape(m.group(1))), frag)
    frag = link_refs(frag)
    frag = autolink(frag)
    out = ""
    for sh in frag.split('<section class="Sh">')[1:]:
        sh = re.sub(r"\s*(</section>\s*)+(</div>\s*)?$", "", sh.rstrip())
        m = re.match(r'\s*<h1 class="Sh"[^>]*>(.*?)</h1>\s*(.*)', sh, re.DOTALL)
        raw = re.sub(r"<[^>]+>", "", m.group(1)).strip()
        parts = m.group(2).split('<section class="Ss">')
        subs = ""
        for ss in parts[1:]:
            ss = re.sub(r"\s*</section>\s*$", "", ss.rstrip())
            m2 = re.match(r'\s*<h2 class="Ss"[^>]*>(.*?)</h2>\s*(.*)', ss, re.DOTALL)
            subs += details("man-sub", title(m2.group(1)), m2.group(2))
        out += details("man-sec", title(m.group(1)), parts[0], raw in OPEN, subs)
    return out


def main():
    ap = argparse.ArgumentParser(description="mandoc man page to collapsible HTML sections")
    ap.add_argument("manfile")
    ap.add_argument("-T", dest="template", help="page template with @TITLE@ and @MAN@")
    ap.add_argument("-t", dest="title", help="page title")
    ap.add_argument("-o", dest="out", help="output file")
    a = ap.parse_args()

    man = Path(a.manfile)
    if not man.is_file():
        sys.exit(f"man2html: {man} not found")
    name = a.title or (f"{man.stem}({man.suffix[1:]})" if man.suffix[1:] else man.stem)
    page = Path(a.template).read_text() if a.template else DEFAULT
    if a.template:  # @include(file)@ pulls in a file next to the template
        tdir = Path(a.template).parent
        page = re.sub(r"@include\(([^)]+)\)@", lambda m: (tdir / m.group(1)).read_text().rstrip("\n"), page)
    frag = subprocess.run(
        ["mandoc", "-Thtml", "-O", "fragment", str(man)],
        check=True, capture_output=True, text=True,
    ).stdout
    dest = Path(a.out) if a.out else man.with_name(man.name + ".html")
    dest.write_text(page.replace("@TITLE@", html.escape(name, quote=False)).replace("@MAN@", convert(frag)))
    print(f"wrote {dest}")


if __name__ == "__main__":
    main()
